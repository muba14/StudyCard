<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_flat"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/HeaderIcon"
            android:contentDescription="Geri"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/note"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/btnEdit"
            style="@style/HeaderIcon"
            android:contentDescription="Düzenle"
            android:src="@drawable/ic_edit" />

        <ImageView
            android:id="@+id/btnDelete"
            style="@style/HeaderIcon"
            android:contentDescription="Sil"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_dark"
                android:textIsSelectable="true"
                android:textSize="26sp" />

            <!-- Tekrar kartı -->
            <LinearLayout
                android:id="@+id/reviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_review_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_search"
                    android:padding="11dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_review"
                        android:textColor="@color/white_70"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white_70"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentCard"
                style="@style/SectionCard">

                <TextView
                    style="@style/SectionTitle"
                    android:drawableStart="@drawable/ic_notes"
                    android:drawableTint="@color/blue"
                    android:text="@string/section_notes" />

                <TextView
                    android:id="@+id/tvContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/text_dark"
                    android:textColorLink="@color/blue"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/imagesCard"
                style="@style/SectionCard">

                <TextView
                    style="@style/SectionTitle"
                    android:drawableStart="@drawable/ic_image"
                    android:drawableTint="@color/blue"
                    android:text="@string/section_images" />

                <LinearLayout
                    android:id="@+id/imagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chartCard"
                style="@style/SectionCard">

                <TextView
                    android:id="@+id/tvChartTitle"
                    style="@style/SectionTitle"
                    android:drawableStart="@drawable/ic_chart"
                    android:drawableTint="@color/blue"
                    android:text="@string/section_chart" />

                <com.studycard.app.ChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="240dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnReviewed"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/reviewed"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </FrameLayout>
</LinearLayout>
